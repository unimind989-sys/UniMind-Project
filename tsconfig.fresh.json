{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "plugins": []
  },
  "include": [
    "*.ts",
    "*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "workers/**/*.ts",
    "evals/**/*.ts"
  ],
  "exclude": ["next-env.d.ts", ".next", "node_modules", "test-results"]
}
