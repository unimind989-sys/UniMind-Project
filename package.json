{
  "name": "unimind",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.19.0"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "check:boundaries": "tsx scripts/check-module-boundaries.ts",
    "scan:secrets": "tsx scripts/scan-repository-secrets.ts",
    "verify:ci-workflow": "tsx scripts/verify-ci-workflow.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test:unit": "tsx scripts/run-vitest-layer.ts unit",
    "test:integration": "tsx scripts/run-vitest-layer.ts integration",
    "test:integration:hosted": "tsx scripts/run-hosted-auth-integration.ts --environment development",
    "test:integration:database": "tsx scripts/run-ephemeral-supabase.ts auth",
    "test:auth:hosted": "tsx scripts/run-hosted-auth-integration.ts --environment development",
    "test:security": "tsx scripts/run-vitest-layer.ts security",
    "test:e2e": "playwright test",
    "browser:cli": "node scripts/run-playwright-cli.mjs",
    "test:eval": "tsx scripts/run-vitest-layer.ts evaluation && tsx scripts/run-foundation-evaluation.ts",
    "test:load": "tsx scripts/run-vitest-layer.ts load && tsx scripts/run-load-suite.ts",
    "smoke:deployment": "tsx scripts/run-deployment-smoke.ts",
    "db:reset": "tsx scripts/run-hosted-supabase.ts reset",
    "db:migrations": "tsx scripts/run-hosted-supabase.ts migrations",
    "db:push:dry-run": "tsx scripts/run-hosted-supabase.ts push-dry-run",
    "db:types": "tsx scripts/run-hosted-supabase.ts types",
    "db:metadata": "tsx scripts/read-hosted-supabase-metadata.ts",
    "db:ci:start": "tsx scripts/run-ephemeral-supabase.ts start",
    "db:ci:reset": "tsx scripts/run-ephemeral-supabase.ts reset",
    "db:ci:migrations": "tsx scripts/run-ephemeral-supabase.ts migrations",
    "db:ci:types": "tsx scripts/run-ephemeral-supabase.ts types",
    "db:ci:stop": "tsx scripts/run-ephemeral-supabase.ts stop",
    "db:types:check": "git diff --exit-code -- src/types/database.generated.ts",
    "test:env-build": "tsx scripts/build-with-safe-env.ts",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm check:boundaries && pnpm verify:ci-workflow && pnpm scan:secrets && pnpm test:unit && pnpm test:integration && pnpm test:security && pnpm test:eval && pnpm test:load && pnpm test:e2e && pnpm test:env-build"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/cli": "0.1.18",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "10.1.8",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "supabase": "2.115.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vercel": "59.9.1",
    "vitest": "4.1.11",
    "yaml": "2.9.0"
  }
}
