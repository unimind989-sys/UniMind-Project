# Browser-safe configuration. These are the only allowed NEXT_PUBLIC_ names.
NEXT_PUBLIC_SUPABASE_URL=https://synthetic.supabase.invalid
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=synthetic-hosted-publishable-key
NEXT_PUBLIC_RELEASE_ID=workstation-mock
NEXT_PUBLIC_TELEMETRY_ENABLED=false

# Server-only synthetic placeholders. They satisfy local validation but do not
# identify or authorize any real database, storage service, queue, or provider.
DATABASE_URL=postgresql://synthetic:synthetic@db.synthetic.invalid:5432/synthetic_workstation
SUPABASE_SERVICE_ROLE_KEY=synthetic-server-credential-only
RAW_STORAGE_CREDENTIAL=synthetic-storage-credential-only
PROCESSED_STORAGE_CREDENTIAL=synthetic-storage-credential-only
QUEUE_SIGNING_SECRET=synthetic-queue-credential-only

# Real providers remain disabled until an approved decision and budget exist.
PROVIDER_MODE=mock
APPROVED_PROVIDER_BUDGET_MINOR=0
GENERATION_PROVIDER_ENABLED=false
GENERATION_PROVIDER_API_KEY=synthetic-disabled-generation-key
EMBEDDING_PROVIDER_ENABLED=false
EMBEDDING_PROVIDER_API_KEY=synthetic-disabled-embedding-key
TRANSCRIPTION_PROVIDER_ENABLED=false
TRANSCRIPTION_PROVIDER_API_KEY=synthetic-disabled-transcription-key

# Bounded operational limits.
MAX_MESSAGE_CHARACTERS=12000
MAX_UPLOAD_BYTES=26214400
MAX_AUDIO_DURATION_SECONDS=1800
MAX_OUTPUT_TOKENS=4096
REQUEST_TIMEOUT_MS=60000
PROVIDER_CONCURRENCY=4
PROVIDER_RETRY_COUNT=3
DAILY_STUDENT_QUOTA=50
